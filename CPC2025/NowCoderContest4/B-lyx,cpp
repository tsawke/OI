#include <bits/stdc++.h>
const int N = 1e6 + 7;
std::vector<std::vector<int>> a, fromS, fromT, col;
int n, m, K, pcol, mx[N];
void dfsS(int x, int y) {
    const static int dx[] = {1, 0, -1}, dy[] = {0, 1, 0};
    fromS[x][y] = 1;
    for(int o = 0; o < 3; o++) {
        int nx = x + dx[o], ny = y + dy[o];
        if(nx < 1 || nx > n || ny < 1 || ny > m || a[nx][ny] || fromS[nx][ny]) continue;
        dfsS(nx, ny);
    }
}
void dfsT(int x, int y) {
    const static int dx[] = {1, 0, -1}, dy[] = {0, -1, 0};
    fromT[x][y] = 1;
    for(int o = 0; o < 3; o++) {
        int nx = x + dx[o], ny = y + dy[o];
        if(nx < 1 || nx > n || ny < 1 || ny > m || a[nx][ny] || fromT[nx][ny]) continue;
        dfsT(nx, ny);
    }
}
void search(int x, int y, int colId) {
    const static int dx[] = {1, 0, -1, 0}, dy[] = {0, 1, 0, -1};
    col[x][y] = colId, mx[colId] = std::max(mx[colId], y);
    // printf(" col[%d][%d] = %d\n", x, y, colId);
    for(int o = 0; o < 4; o++) {
        int nx = x + dx[o], ny = y + dy[o];
        if(nx < 1 || nx > n || ny < 1 || ny > m || a[nx][ny] || fromT[nx][ny] || col[nx][ny]) continue;
        search(nx, ny, colId);[]
    }
}
bool solve() {
    scanf("%d%d%d", &n, &m, &K), pcol = 0;
    a.clear(), a.resize(n + 2, std::vector<int>(m + 2, 1));
    fromS.clear(), fromS.resize(n + 2, std::vector<int>(m + 2, 0));
    fromT.clear(), fromT.resize(n + 2, std::vector<int>(m + 2, 0));
    col.clear(), col.resize(n + 2, std::vector<int>(m + 2, 0));
    // for(int i = 1; i <= n; i++) {
    //     printf(" > ");
    //     for(int j = 1; j <= m; j++) printf("%d", a[i][j]);
    //     puts("");
    // }
    for(int i = 1; i <= n; i++) {
        static char s[N]; scanf("%s", s + 1);
        for(int j = 1; j <= m; j++) a[i][j] = s[j] - '0';
    }
    dfsS(1, 1), dfsT(1, m);
    // puts("--- a"), fflush(stdout);
    // for(int i = 1; i <= n; i++) {
    //     for(int j = 1; j <= m; j++) printf("%d", a[i][j]);
    //     puts("");
    // }
    // puts("--- fromT"), fflush(stdout);
    // for(int i = 1; i <= n; i++) {
    //     for(int j = 1; j <= m; j++) printf("%d", fromT[i][j]);
    //     puts("");
    // }
    for(int i = 1; i <= n; i++) for(int j = 1; j <= m; j++) {
        if(!a[i][j] && !fromT[i][j] && !col[i][j]) mx[++pcol] = 0, search(i, j, pcol);
    }
    for(int i = 1; i <= n; i++) for(int j = 1; j <= m; j++) {
        if(!a[i][j] && fromS[i][j] && fromT[i][j] && !a[i][j + 1] && !fromT[i][j + 1]) {
            if(mx[col[i][j + 1]] - j >= K) return 1;
        }
    }
    return 0;
}
int main() {
    int T; scanf("%d", &T); while(T--) puts(solve() ? "Yes" : "No");
    return 0;
}