struct P { double x, y; };
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    if(!(cin >> n)) return 0;
    vector<P> c(n);
    vector<double> l2(n);
    for (int i = 0; i < n; ++i) {
        int xi, yi, li2;
        cin >> xi >> yi >> li2;
        c[i] = {(double)xi, (double)yi};
        l2[i] = (double)li2;
    }

    auto h_val = [&](double x, double y, int* argmin = nullptr)->double {
        double best = 1e300; int idx = -1;
        for (int i = 0; i < n; ++i) {
            double dx = x - c[i].x, dy = y - c[i].y;
            double val = l2[i] - (dx*dx + dy*dy);
            if (val < best) { best = val; idx = i; }
        }
        if (argmin) *argmin = idx;
        return best; // = h(x,y)
    };

    auto climb_from = [&](double xs, double ys)->tuple<double,double,double> {
        double x = xs, y = ys;
        double hv = h_val(x,y,nullptr);
        double step = 512.0;                  // 初始大步长
        const double SHRINK = 0.55;           // 步长衰减
        const double EPS_STEP = 1e-12;
        const int STALL_TRY = 50;             // 每个步长最多尝试若干次
        while (step > EPS_STEP) {
            bool improved = false;
            for (int t = 0; t < STALL_TRY; ++t) {
                int k; double m = h_val(x,y,&k); // 最紧约束
                double vx = c[k].x - x, vy = c[k].y - y;
                double vn = hypot(vx, vy);
                if (vn < 1e-18) { // 已在该中心上，改试微扰方向
                    vx = 1.0; vy = 0.0; vn = 1.0;
                }
                vx /= vn; vy /= vn;
                double nx = x + vx * step;
                double ny = y + vy * step;
                double nv = h_val(nx, ny, nullptr);
                if (nv > hv) { x = nx; y = ny; hv = nv; improved = true; break; }
                // 试几个扇区方向，避免“被别的约束卡住”的假停滞
                double angs[4] = {M_PI*0.25, -M_PI*0.25, M_PI*0.5, -M_PI*0.5};
                bool jumped = false;
                for (double a : angs) {
                    double cs = cos(a), sn = sin(a);
                    double vx2 = vx*cs - vy*sn, vy2 = vx*sn + vy*cs;
                    nx = x + vx2 * step; ny = y + vy * step;
                    nv = h_val(nx, ny, nullptr);
                    if (nv > hv) { x = nx; y = ny; hv = nv; improved = true; jumped = true; break; }
                }
                if (jumped) break;
            }
            if (!improved) step *= SHRINK;
        }
        return {x, y, hv};
    };

    // 多起点：原点 + 若干代表点
    vector<pair<double,double>> seeds;
    seeds.emplace_back(0.0, 0.0);
    for (int i = 0; i < n && (int)seeds.size() < 12; ++i) seeds.emplace_back(c[i].x, c[i].y);

    double bestH = -1e300, bx = 0, by = 0;
    for (auto [sx, sy] : seeds) {
        auto [x, y, hv] = climb_from(sx, sy);
        if (hv > bestH) { bestH = hv; bx = x; by = y; }
    }

    // 交集一定非空（题设保证 l_i^2 > x_i^2 + y_i^2，原点在所有球里），故 bestH >= 0
    if (bestH < 0) bestH = 0; // 数值保险
    double bz = -sqrt(max(0.0, bestH));

    cout.setf(ios::fixed); cout << setprecision(12);
    cout << bx << " " << by << " " << bz << "\n";
    return 0;
}