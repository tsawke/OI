    auto Worst = [&](double x, double y, int *idx = nullptr)->double{
        double mx = -1e300;
        int id = 0;
        for(int i = 0; i < (int)rops.size(); ++i){
            double dx = x - rops[i].x, dy = y - rops[i].y;
            double val = dx * dx + dy * dy - (double)rops[i].l2; // 要最小化的 max 值
            if(val > mx){ mx = val; id = i; }
        }
        if(idx) *idx = id; // 注意：返回 0-based
        return mx;
    };
    auto MinZ2 = [&](double x, double y)->double{
        double mn = 1e300;
        for(int i = 0; i < (int)rops.size(); ++i){
            double dx = x - rops[i].x, dy = y - rops[i].y;
            double v = (double)rops[i].l2 - dx * dx - dy * dy;
            if(v < mn) mn = v;
        }
        return mn;
    };

    // 确定性次梯度下降：每一步朝“最坏约束”的圆心移动一个固定长度 step，逐步缩小 step
    double x = 0.0, y = 0.0;
    double step = 256.0;
    while(step > 1e-7){
        int id; Worst(x, y, &id);                 // 找到当前使 max 达到的那个约束
        double dx = rops[id].x - x, dy = rops[id].y - y;
        double len = hypot(dx, dy);
        if(len > 1e-12){
            x += dx / len * step;
            y += dy / len * step;
        }
        step *= 0.997; // 收敛用的衰减系数，~7k 步
    }

    double z2 = MinZ2(x, y);
    if(z2 < 0) z2 = 0; // 数值误差保护
    double z = -sqrt(z2);

    printf("%.9lf %.9lf %.9lf\n", x, y, z);




